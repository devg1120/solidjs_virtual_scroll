          </p>
        </div>
        <button
          type="button"
          class="counter"
          onClick={() => setCount((count) => count + 1)}
        >
          Count is {count()}
        </button>
      </section>
      <Button onClick={() => alert("Hello Libra UI!")}>
        Click Me
      </Button>
      <Table columns={ColumnDefs} 
             data={Data} 
             showRowBorder={true}
	     rowHeight={30}

	     ></Table>

    </>
  )
}

export default App
